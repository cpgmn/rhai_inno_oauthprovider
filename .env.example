# Environment Variables

## Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=identity_and_access
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

## OIDC
OIDC_ISSUER=http://localhost:8080

## JWT Keys (generate with scripts/generate_keys.py)
# Keys should be loaded as PEM-encoded strings
# Newlines in environment can be escaped as \n
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=key-1

## Session
SESSION_SECRET_KEY=change-this-in-production

## Token Lifetimes
ACCESS_TOKEN_EXPIRE_SECONDS=3600
REFRESH_TOKEN_EXPIRE_SECONDS=2592000
AUTH_CODE_EXPIRE_SECONDS=300
